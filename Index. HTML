<!DOCTYPE html>
<html lang="mr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TS SHOTOKAN KARATE DO ASSOCIATION OF INDIA - Official Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Poppins:wght@400;600;700&family=Yantramanav:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', 'Yantramanav', sans-serif; }
        .font-header { font-family: 'Cinzel', serif; }
        .hero-gradient { background: linear-gradient(135deg, #1e1b18 0%, #4a0d0d 50%, #111827 100%); }
        .gold-border { border: 2px solid #d4af37; }
        .gold-text { color: #d4af37; }
        .glass-card { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); }
        @media print {
            body * { visibility: hidden; }
            #printableCertificate, #printableCertificate * { visibility: visible; }
            #printableCertificate { position: absolute; left: 0; top: 0; width: 100%; }
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col justify-between">

    <!-- Header / Navbar -->
    <header class="bg-slate-950/80 backdrop-blur-md border-b border-red-900/50 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="w-12 h-12 bg-red-600 rounded-full flex items-center justify-center font-bold text-xl border-2 border-amber-400 shadow-lg">
                    🥋
                </div>
                <div>
                    <h1 class="text-sm md:text-xl font-bold font-header tracking-wider text-amber-400 leading-tight">
                        TS SHOTOKAN KARATE DO
                    </h1>
                    <p class="text-[10px] md:text-xs text-slate-400 uppercase tracking-widest">Association of India</p>
                </div>
            </div>
            <button onclick="openAdmin()" class="bg-red-900/40 hover:bg-red-800 text-amber-300 border border-amber-500/40 px-4 py-1.5 rounded-full text-xs font-semibold transition flex items-center gap-1">
                <i data-lucide="lock" class="w-3.5 h-3.5"></i> अ‍ॅडमिन
            </button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow hero-gradient py-12 px-4 relative overflow-hidden flex flex-col items-center justify-center">
        <!-- Background Decorative Watermark -->
        <div class="absolute inset-0 opacity-5 pointer-events-none flex items-center justify-center">
            <span class="text-[180px] font-bold font-header">SHOTOKAN</span>
        </div>

        <div class="max-w-xl w-full z-10 space-y-8">
            
            <!-- Main Search Box -->
            <div class="glass-card text-slate-900 rounded-3xl p-6 md:p-8 shadow-2xl border border-amber-500/30 relative">
                <div class="text-center mb-6">
                    <span class="bg-red-100 text-red-800 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Official Examination Portal</span>
                    <h2 class="text-2xl md:text-3xl font-bold mt-2 text-slate-900">विद्यार्थी निकाल शोध प्रणाली</h2>
                    <p class="text-xs text-slate-500 mt-1">तुमचा रोल नंबर आणि आईचे नाव टाकून बेल्ट परीक्षा निकाल तपासा</p>
                </div>

                <form onsubmit="handleSearch(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Roll Number (रोल नंबर)</label>
                        <div class="relative">
                            <i data-lucide="badge-check" class="w-5 h-5 absolute left-3 top-3 text-slate-400"></i>
                            <input type="text" id="searchRoll" placeholder="उदा. TS-2026-001" required 
                            class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:outline-none uppercase font-semibold text-slate-800">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Mother's Name (आईचे नाव)</label>
                        <div class="relative">
                            <i data-lucide="user" class="w-5 h-5 absolute left-3 top-3 text-slate-400"></i>
                            <input type="text" id="searchMother" placeholder="आईचे नाव टाईप करा" required 
                            class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-red-600 focus:outline-none font-semibold text-slate-800">
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-gradient-to-r from-red-700 to-red-900 hover:from-red-800 hover:to-red-950 text-amber-300 font-bold py-3.5 rounded-xl shadow-lg transition duration-200 flex items-center justify-center gap-2 border border-amber-500/40">
                        <i data-lucide="search" class="w-5 h-5"></i> निकाल शोधा
                    </button>
                </form>
            </div>

            <!-- Result Certificate Card (Hidden Initially) -->
            <div id="resultDisplay" class="hidden">
                <div id="printableCertificate" class="bg-amber-50 text-slate-900 p-8 rounded-3xl border-8 border-double border-amber-600 shadow-2xl relative overflow-hidden">
                    
                    <!-- Watermark -->
                    <div class="absolute inset-0 opacity-5 flex items-center justify-center pointer-events-none">
                        <span class="text-9xl">🥋</span>
                    </div>

                    <!-- Certificate Header -->
                    <div class="text-center border-b-2 border-amber-800/30 pb-4 mb-6">
                        <h3 class="text-lg md:text-2xl font-bold font-header text-red-900 uppercase tracking-widest">TS SHOTOKAN KARATE DO ASSOCIATION OF INDIA</h3>
                        <p class="text-xs text-amber-900 font-semibold uppercase tracking-wider mt-1">Official Belt Examination Certificate</p>
                    </div>

                    <!-- Certificate Body -->
                    <div class="space-y-4 text-sm">
                        <div class="flex justify-between items-center border-b border-amber-200 pb-2">
                            <span class="text-slate-600 font-medium">विद्यार्थ्याचे नाव:</span>
                            <span id="rName" class="font-bold text-slate-900 text-lg"></span>
                        </div>
                        <div class="flex justify-between items-center border-b border-amber-200 pb-2">
                            <span class="text-slate-600 font-medium">आईचे नाव:</span>
                            <span id="rMother" class="font-semibold text-slate-800"></span>
                        </div>
                        <div class="flex justify-between items-center border-b border-amber-200 pb-2">
                            <span class="text-slate-600 font-medium">रोल नंबर:</span>
                            <span id="rRoll" class="font-mono font-bold text-red-800"></span>
                        </div>
                        <div class="flex justify-between items-center border-b border-amber-200 pb-2">
                            <span class="text-slate-600 font-medium">प्राप्त बेल्ट (Belt Grade):</span>
                            <span id="rBelt" class="font-bold text-amber-800 px-3 py-0.5 bg-amber-200/60 rounded"></span>
                        </div>
                        <div class="flex justify-between items-center border-b border-amber-200 pb-2">
                            <span class="text-slate-600 font-medium">ग्रेड (Grade):</span>
                            <span id="rGrade" class="font-bold text-green-700"></span>
                        </div>
                    </div>

                    <!-- Status Banner -->
                    <div class="mt-6 bg-green-800 text-white text-center py-3 rounded-xl font-bold text-lg tracking-wide shadow-md flex items-center justify-center gap-2">
                        <i data-lucide="check-circle" class="w-6 h-6 text-green-300"></i> परीक्षा निकाल: उत्तीर्ण (PASSED)
                    </div>

                    <!-- Footer Signatures -->
                    <div class="mt-8 pt-4 flex justify-between items-end text-center text-xs font-semibold text-slate-700">
                        <div>
                            <div class="w-24 border-b border-slate-400 mb-1 mx-auto"></div>
                            <p>Chief Examiner</p>
                        </div>
                        <div>
                            <div class="w-24 border-b border-slate-400 mb-1 mx-auto"></div>
                            <p>Authorized Signature</p>
                        </div>
                    </div>

                    <!-- Download/Print Button (Won't show in print) -->
                    <div class="mt-6 text-center print:hidden">
                        <button onclick="window.print()" class="bg-slate-900 hover:bg-slate-800 text-amber-400 font-bold px-6 py-2 rounded-xl text-xs flex items-center justify-center gap-2 mx-auto border border-amber-500/30">
                            <i data-lucide="printer" class="w-4 h-4"></i> प्रमाणपत्र डाउनलोड / प्रिंट करा
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- Admin Modal Panel -->
    <div id="adminModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 z-50">
        <div class="bg-slate-900 text-white p-6 md:p-8 rounded-3xl max-w-md w-full border border-amber-500/30 shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="font-bold text-lg text-amber-400 flex items-center gap-2">
                    <i data-lucide="shield" class="w-5 h-5"></i> अ‍ॅडमिन डेटा सेंटर
                </h3>
                <button onclick="closeAdmin()" class="text-slate-400 hover:text-white">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <input type="password" id="adminPass" placeholder="अ‍ॅडमिन पासवर्ड टाका" class="w-full p-3 bg-slate-800 border border-slate-700 rounded-xl text-slate-200 focus:outline-none focus:ring-2 focus:ring-red-600">
            
            <div id="adminForm" class="space-y-3 hidden pt-2">
                <p class="text-xs text-green-400 font-semibold flex items-center gap-1">
                    <i data-lucide="wifi" class="w-4 h-4"></i> क्लाउड डेटाबेस लाईव्ह कनेक्ट आहे
                </p>
                <input type="text" id="stRoll" placeholder="Roll No (उदा. TS-2026-001)" class="w-full p-2.5 bg-slate-800 border border-slate-700 rounded-lg text-xs uppercase">
                <input type="text" id="stName" placeholder="विद्यार्थ्याचे पूर्ण नाव" class="w-full p-2.5 bg-slate-800 border border-slate-700 rounded-lg text-xs">
                <input type="text" id="stMother" placeholder="आईचे नाव" class="w-full p-2.5 bg-slate-800 border border-slate-700 rounded-lg text-xs">
                <input type="text" id="stBelt" placeholder="Belt (उदा. Yellow / Green / Black)" class="w-full p-2.5 bg-slate-800 border border-slate-700 rounded-lg text-xs">
                <input type="text" id="stGrade" placeholder="Grade (A+ / A / B)" class="w-full p-2.5 bg-slate-800 border border-slate-700 rounded-lg text-xs">
                
                <button onclick="saveToGlobalCloud()" class="w-full bg-red-700 hover:bg-red-800 text-amber-300 text-xs font-bold py-3 rounded-xl transition shadow-lg border border-amber-500/30 flex items-center justify-center gap-1">
                    <i data-lucide="cloud-upload" class="w-4 h-4"></i> सर्व जगासाठी अपडेट करा
                </button>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-slate-950 border-t border-slate-800/80 py-4 text-center text-xs text-slate-500">
        <p>© 2026 TS SHOTOKAN KARATE DO ASSOCIATION OF INDIA. All Rights Reserved.</p>
    </footer>

    <!-- Logic Script -->
    <script>
        lucide.createIcons();

        const BIN_ID = "6a81b250f5f4af5e291cd76e";
        const MASTER_KEY = "$2a$10$BcBhPHVHpxxd0AQCWdnLmOqOmy8E/L9OJzizjUpF1uE1cA51L6Hma";
        const API_URL = `https://api.jsonbin.io/v3/b/${BIN_ID}`;

        async function getGlobalDB() {
            try {
                const res = await fetch(API_URL, {
                    headers: { "X-Master-Key": MASTER_KEY }
                });
                const data = await res.json();
                return data.record || {};
            } catch (err) {
                console.error(err);
                return {};
            }
        }

        async function handleSearch(e) {
            e.preventDefault();
            const roll = document.getElementById("searchRoll").value.trim().toUpperCase();
            const mother = document.getElementById("searchMother").value.trim();

            const db = await getGlobalDB();
            const student = db[roll];

            if (student && student.mother.toLowerCase() === mother.toLowerCase()) {
                document.getElementById("rName").innerText = student.name;
                document.getElementById("rMother").innerText = student.mother;
                document.getElementById("rRoll").innerText = student.roll;
                document.getElementById("rBelt").innerText = student.belt;
                document.getElementById("rGrade").innerText = student.grade;
                
                const display = document.getElementById("resultDisplay");
                display.classList.remove("hidden");
                display.scrollIntoView({ behavior: 'smooth' });
            } else {
                alert("माहिती सापडली नाही! कृपया रोल नंबर आणि आईचे नाव तपासा.");
            }
        }

        function openAdmin() { document.getElementById("adminModal").classList.remove("hidden"); }
        function closeAdmin() { document.getElementById("adminModal").classList.add("hidden"); }

        document.getElementById("adminPass").addEventListener("input", function(e) {
            if (e.target.value === "admin123") {
                document.getElementById("adminForm").classList.remove("hidden");
            }
        });

        async function saveToGlobalCloud() {
            const roll = document.getElementById("stRoll").value.trim().toUpperCase();
            if (!roll) { alert("Roll Number आवश्यक आहे!"); return; }

            const newStudent = {
                roll: roll,
                name: document.getElementById("stName").value.trim(),
                mother: document.getElementById("stMother").value.trim(),
                belt: document.getElementById("stBelt").value.trim(),
                grade: document.getElementById("stGrade").value.trim()
            };

            let currentDB = await getGlobalDB();
            currentDB[roll] = newStudent;

            const res = await fetch(API_URL, {
                method: "PUT",
                headers: {
                    "Content-Type": "application/json",
                    "X-Master-Key": MASTER_KEY
                },
                body: JSON.stringify(currentDB)
            });

            if (res.ok) {
                alert("डेटा यशस्वीरीत्या क्लाउडवर सेव्ह झाला आहे! आता सर्व उपकरणांवर दिसेल.");
                closeAdmin();
            } else {
                alert("सेव्ह करताना त्रुटी आली!");
            }
        }
    </script>
</body>
</html>
